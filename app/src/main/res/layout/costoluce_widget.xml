<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/costoluce_widget_bg"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COSTO LUCE   •   v5.3"
        android:textSize="11sp"
        android:textColor="#C3D5FF"
        android:fontFamily="sans"
        android:letterSpacing="0.08"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_euro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:textSize="30sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_kwh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nessun dato"
        android:textColor="#76E2CE"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/widget_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Apri l'app e salva i consumi"
        android:textColor="#E1EAFB"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Non ancora aggiornato"
        android:textColor="#A6BCD8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
