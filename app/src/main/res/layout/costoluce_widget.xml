<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/costoluce_widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="COSTO LUCE  •  v5.6"
            android:textSize="11sp"
            android:textColor="#C3D5FF"
            android:fontFamily="sans"
            android:letterSpacing="0.06"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/costoluce_widget_refresh_bg"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Aggiorna i consumi Enel e il costo stimato" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_euro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:textSize="29sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_kwh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nessun dato"
        android:textColor="#76E2CE"
        android:textStyle="bold"
        android:textSize="17sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Apri l'app e salva i consumi"
        android:textColor="#E1EAFB"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Nessun aggiornamento salvato"
        android:textColor="#A6BCD8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:background="@drawable/costoluce_widget_refresh_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Aggiorna consumi e costo senza aprire l'app"
        android:text="↻  Aggiorna consumi e costo"
        android:textColor="#D6E6FF"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
