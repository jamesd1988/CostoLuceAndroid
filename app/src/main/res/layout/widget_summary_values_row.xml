<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
  <LinearLayout android:id="@+id/widget_value_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/widget_value_label_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B6CBE6" android:maxLines="1" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_value_amount_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:includeFontPadding="false" />
  </LinearLayout>
  <LinearLayout android:id="@+id/widget_value_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/widget_value_label_right" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B6CBE6" android:maxLines="1" android:includeFontPadding="false" />
    <TextView android:id="@+id/widget_value_amount_right" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" android:includeFontPadding="false" />
  </LinearLayout>
</LinearLayout>
