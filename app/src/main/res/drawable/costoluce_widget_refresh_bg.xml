<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#4064E7CF">
    <item>
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="oval">
                <gradient android:angle="270" android:startColor="#173E68" android:endColor="#0D294A" />
                <stroke android:width="1dp" android:color="#477F98" />
            </shape>
        </inset>
    </item>
    <item android:id="@android:id/mask">
        <inset android:insetLeft="4dp" android:insetTop="4dp" android:insetRight="4dp" android:insetBottom="4dp">
            <shape android:shape="oval"><solid android:color="#FFFFFF" /></shape>
        </inset>
    </item>
</ripple>
